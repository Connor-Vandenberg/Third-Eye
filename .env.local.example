# =============================================================================
# THIRD-EYE FRONTEND - ENVIRONMENT VARIABLES
# =============================================================================
# GZM Backend connections (Gray Zone Monitor Python backend)
# =============================================================================

# GZM API Server (FastAPI, AIP 82+ tools, TAXII 2.1)
# Docker: http://gzm-api:8080 | Local dev: http://localhost:8080
NEXT_PUBLIC_GZM_API_URL=http://localhost:8080

# GZM MCP Server (57+ AI agent tools, streamable HTTP)
# Docker: http://gzm-mcp:8090 | Local dev: http://localhost:8090
NEXT_PUBLIC_GZM_MCP_URL=http://localhost:8090

# GZM GEOINT Pipeline (VIIRS + SAR + NL query)
# Docker: http://gzm-geoint:8080 | Local dev: http://localhost:8083
NEXT_PUBLIC_GZM_GEOINT_URL=http://localhost:8083

# GZM ISR Tasking (CBBA + satellite + drone allocation)
# Docker: http://gzm-isr:8087 | Local dev: http://localhost:8087
NEXT_PUBLIC_GZM_ISR_URL=http://localhost:8087

# GZM Reporting (ICD-203 reports, STIX 2.1)
# Docker: http://gzm-reporting:8086 | Local dev: http://localhost:8086
NEXT_PUBLIC_GZM_REPORTING_URL=http://localhost:8086

# CesiumJS Map (3D globe with 20 AOIs)
NEXT_PUBLIC_MAP_URL=https://map.grayzonemonitor.com

# WebSocket for real-time signal updates (via God's Eye)
NEXT_PUBLIC_GZM_WS_URL=ws://localhost:9090/ws

# =============================================================================
# Authentication (Clerk)
# =============================================================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# =============================================================================
# External Data Sources (optional, keyless feeds work without these)
# =============================================================================
# NASA FIRMS (active fire detection)
FIRMS_API_KEY=

# AIS Stream (maritime vessel tracking)
AIS_API_KEY=

# OpenSky (aviation tracking, higher rate limits)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# N2YO (satellite tracking)
N2YO_API_KEY=

# =============================================================================
# Deployment
# =============================================================================
# Production domain
NEXT_PUBLIC_APP_URL=https://grayzonemonitor.com

# Plausible analytics (cookie-free)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=grayzonemonitor.com
NEXT_PUBLIC_PLAUSIBLE_URL=https://analytics.grayzonemonitor.com
