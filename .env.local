# GZM Third-Eye Local Development Environment
# Backend must be running: cd Gray-Zone-Monitor && uvicorn api.app:app --port 8000

NEXT_PUBLIC_GZM_API_URL=http://localhost:8000
NEXT_PUBLIC_GZM_WS_URL=ws://localhost:8000
NEXT_PUBLIC_GZM_MCP_URL=http://localhost:8090
NEXT_PUBLIC_GZM_GEOINT_URL=http://localhost:8083
NEXT_PUBLIC_GZM_ISR_URL=http://localhost:8087
NEXT_PUBLIC_GZM_REPORTING_URL=http://localhost:8086

# MapLibre (free, no key needed for OSM/CARTO tiles)
# If using Mapbox: NEXT_PUBLIC_MAPBOX_TOKEN=pk.xxx

# Cesium Ion (for 3D globe terrain)
# NEXT_PUBLIC_CESIUM_ION_TOKEN=xxx
